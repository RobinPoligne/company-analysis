{"ticker":"MKC","name":"McCormick & Company, Incorporated","sector":"Consumer Defensive","industry":"Packaged Foods","country":"United States","price":{"last":46.06,"market_cap":12393110528,"pe_ratio":8.329114,"high_52w":72.41,"low_52w":43.25,"shares_outstanding":254541615,"beta":0.641,"as_of":"2026-10-28"},"stats":{"forward_pe":14.298176,"ps_ratio":1.6124895,"pb_ratio":1.7696328,"enterprise_value":17664010240,"ev_ebitda":11.744,"peg":3.109,"roe":0.22623,"roa":0.05252,"gross_margin":0.38914,"eps":5.53,"forward_eps":3.22139,"avg_50":49.6154,"avg_200":53.66285,"target_mean":54.455,"analyst_count":14,"rating":"buy","target_low":47.0,"target_high":65.0,"prev_close":47.48,"day_low":45.4,"day_high":46.64,"volume":4434243},"profile":{"description":"McCormick & Company, Incorporated manufactures, markets, and distributes herbs, spices, seasoning mixes, condiments, and other flavorful products to the food industry. It operates in two segments, Consumer and Flavor Solutions. The Consumer segment offers spices, herbs, and seasonings, as well as condiments, sauces, and desserts. This segment markets its products under the McCormick, French's, Frank's RedHot, Lawry's, Cholula Hot Sauce, Club House, Gourmet Garden, and OLD BAY brands in the Americas; Ducros, Schwartz, Kamis, LA Drogheria, and Vahin\u00e9 brands in Europe, the Middle East, and Africa; and McCormick and DaQiao brands in the Asia/Pacific (APAC), as well as desserts under the Aeroplane brand; and packaged chilled herbs under the Gourmet Garden brand. Its authentic regional brands include Zatarain's, Stubb's, Thai Kitchen, and Simply Asia. The company also supplies its products under private labels. This segment serves retailers, including grocery, mass merchandise, warehouse clubs, discount and drug stores, and e-commerce retailers directly and indirectly through distributors and wholesale foodservice suppliers. The Flavor Solutions segment offers seasoning blends, spices, herbs, condiments, coating systems, and compound flavors to multinational food manufacturers and foodservice customers. It serves foodservice customers directly and indirectly through distributors. The company was founded in 1889 and is headquartered in Hunt Valley, Maryland.","employees":14100,"website":"https://www.mccormickcorporation.com"},"financials":{"revenue":{"2022":6350500000.0,"2023":6662200000.0,"2024":6723700000.0,"2025":6840300000.0},"net_income":{"2022":682000000.0,"2023":680600000.0,"2024":788500000.0,"2025":789400000.0},"operating_income":{"2022":917400000.0,"2023":1024200000.0,"2024":1069800000.0,"2025":1091900000.0},"free_cash_flow":{"2022":389500000.0,"2023":973400000.0,"2024":647000000.0,"2025":740400000.0},"total_debt":{"2022":5325700000.0,"2023":4591300000.0,"2024":4508500000.0,"2025":4164000000.0},"equity":{"2022":4680500000.0,"2023":5060700000.0,"2024":5291000000.0,"2025":5736500000.0},"cash":{"2022":334000000.0,"2023":166600000.0,"2024":186100000.0,"2025":95900000.0},"current_assets":{"2022":2386700000.0,"2023":2001600000.0,"2024":2139000000.0,"2025":2138100000.0},"current_liabilities":{"2022":3432400000.0,"2023":3098900000.0,"2024":2882800000.0,"2025":3062200000.0}},"ttm":{"free_cash_flow":925900000.0,"through":"2026-08-31"},"prices_short":{"1d":[["2026-10-28 09:30",46.18],["2026-10-28 09:35",46.15],["2026-10-28 09:40",46.21],["2026-10-28 09:45",46.43],["2026-10-28 09:50",46.64],["2026-10-28 09:55",46.56],["2026-10-28 10:00",46.34],["2026-10-28 10:05",46.42],["2026-10-28 10:10",46.37],["2026-10-28 10:15",46.34],["2026-10-28 10:20",46.24],["2026-10-28 10:25",46.31],["2026-10-28 10:30",46.34],["2026-10-28 10:35",46.31],["2026-10-28 10:40",46.12],["2026-10-28 10:45",46.16],["2026-10-28 10:50",46.11],["2026-10-28 10:55",46.1],["2026-10-28 11:00",46.09],["2026-10-28 11:05",46.06],["2026-10-28 11:10",45.99],["2026-10-28 11:15",45.92],["2026-10-28 11:20",45.97],["2026-10-28 11:25",45.86],["2026-10-28 11:30",45.99],["2026-10-28 11:35",45.79],["2026-10-28 11:40",45.79],["2026-10-28 11:45",45