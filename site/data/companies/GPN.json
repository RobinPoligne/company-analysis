{"ticker":"GPN","name":"Global Payments Inc.","sector":"Industrials","industry":"Specialty Business Services","country":"United States","price":{"last":83.55,"market_cap":22108866560,"pe_ratio":39.225353,"high_52w":95.88,"low_52w":61.16,"shares_outstanding":264618390,"beta":0.805,"as_of":"2026-10-28"},"stats":{"forward_pe":5.189129,"ps_ratio":2.1661034,"pb_ratio":0.9609634,"enterprise_value":41114656768,"ev_ebitda":9.173,"peg":0.1993,"roe":0.02428,"roa":0.023340002,"gross_margin":0.63959,"eps":2.13,"forward_eps":16.10097,"avg_50":86.4602,"avg_200":76.7598,"target_mean":105.06061,"analyst_count":33,"rating":"buy","target_low":70.0,"target_high":194.0,"prev_close":81.43,"day_low":80.85,"day_high":83.77,"volume":1706041},"profile":{"description":"Global Payments Inc. provides payment technology and software solutions for card, check, and digital-based payments in the Americas, Europe, and the Asia-Pacific. It offers authorization, settlement and funding, customer support, chargeback resolution, reconciliation and dispute management, terminal rental, sales and deployment, payment security, and consolidated billing and reporting services. The company also provides an array of enterprise software solutions that streamline business operations of its customers in various vertical markets; and value-added solutions and services, such as point-of-sale software, analytics and customer engagement, payroll and reporting, and human capital management. It markets its products and services through direct sales force, trade associations, agent and enterprise software providers, referral arrangements with value-added resellers, independent sales organizations, payment facilitators, and financial institutions. The company was founded in 1967 and is headquartered in Atlanta, Georgia.","employees":26000,"website":"https://www.globalpayments.com"},"financials":{"revenue":{"2022":8975515000.0,"2023":7379784000.0,"2024":7735970000.0,"2025":7705878000.0},"net_income":{"2022":111493000.0,"20