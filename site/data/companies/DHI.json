{"ticker":"DHI","name":"D.R. Horton, Inc.","sector":"Consumer Cyclical","industry":"Residential Construction","country":"United States","price":{"last":143.0,"market_cap":39997284352,"pe_ratio":13.6320305,"high_52w":170.79,"low_52w":130.4,"shares_outstanding":279701267,"beta":1.351,"as_of":"2026-10-28"},"stats":{"forward_pe":12.76151,"ps_ratio":1.1993189,"pb_ratio":1.6853667,"enterprise_value":45693480960,"ev_ebitda":11.071,"peg":1.2346,"roe":0.12632,"roa":0.06884,"gross_margin":0.21298,"eps":10.49,"forward_eps":11.20557,"avg_50":140.9958,"avg_200":147.8076,"target_mean":152.35715,"analyst_count":14,"rating":"hold","target_low":119.0,"target_high":206.0,"prev_close":147.02,"day_low":140.605,"day_high":148.4341,"volume":5899976},"profile":{"description":"D.R. Horton, Inc. operates as a homebuilding company in East, North, Southeast, South Central, Southwest, and Northwest regions in the United States. It engages in the acquisition and development of land; and construction and sale of residential homes in 126 markets across 36 states under the names of D.R. Horton. The company also constructs and sells single-family detached homes; and attached homes, such as townhomes and duplexes. In addition, it provides mortgage financing and title agency services; and engages in the residential lot development business. Further, the company develops, constructs, owns, leases, and sells multi-family and single-family rental properties; conducts insurance-related operations; and owns water rights and other water-related assets, as well as non-residential real estate, including ranch land and improvements. It primarily serves homebuyers. D.R. Horton, Inc. was founded in 1978 and is headquartered in Arlington, Texas.","employees":14341,"website":"https://www.drhorton.com"},"financials":{"revenue":{"2022":33480000000.0,"2023":35460400000.0,"2024":36801400000.0,"2025":34250400000.0},"net_income":{"2022":5857500000.0,"2023":4745700000.0,"2024":4756400000.0,"2025":3585200000.0},"operatin