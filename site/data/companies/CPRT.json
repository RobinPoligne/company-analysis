{"ticker":"CPRT","name":"Copart, Inc.","sector":"Industrials","industry":"Specialty Business Services","country":"United States","price":{"last":28.96,"market_cap":26826528768,"pe_ratio":18.68387,"high_52w":43.7,"low_52w":25.72,"shares_outstanding":926330452,"beta":1.058,"as_of":"2026-10-28"},"stats":{"forward_pe":16.0,"ps_ratio":5.749106,"pb_ratio":2.9487832,"enterprise_value":22441680896,"ev_ebitda":12.025,"peg":2.9011,"roe":0.1616,"roa":0.10268,"gross_margin":0.45291,"eps":1.55,"forward_eps":1.81,"avg_50":29.7872,"avg_200":32.5249,"target_mean":39.0,"analyst_count":10,"rating":"buy","target_low":25.0,"target_high":55.0,"prev_close":28.92,"day_low":28.436,"day_high":28.98,"volume":11402443},"profile":{"description":"Copart, Inc. provides online auctions and vehicle remarketing services in the United States, the United Kingdom, Germany, Brazil, Canada, the United Arab Emirates, Spain, Finland, Oman, the Republic of Ireland, and Bahrain. The company provides a range of services to process and sell vehicles over the internet through its virtual bidding third generation internet auction-style sales technology. It offers services, such as online seller access; salvage estimation; estimating; end-of-life vehicle processing; transportation; vehicle inspection stations; on-demand reporting; title processing and express; loan payoff; flexible vehicle processing programs; buy it now and make an offer; sales process; and dealer services. In addition, the company provides IntelliSeller, an automated tool that leverages its vehicle and sales data to assist its sellers in making vital auction decisions; BluCar to sell vehicles of financial institutions, fleet, and rental car companies; CashForCars.com, CashForCars.ca, CashForCars.de, CashForCars.co.uk, and Cash-for-cars.ie; and national powersport auctions services, which include services through live and online auction platforms to dealers, financial institutions, and original equipment manufacturers. Further, it offers wholesale construction, agriculture, and fleet remarketing services through no-reserve online auctions under Purple Wave brand name; Copart Recycling services; and Copart 360, a technology that captures clear 360-degree views of interiors and exteriors of cars, trucks, and vans. The company sells the vehicles to licensed vehicle dismantlers, rebuilders, repair licenses, used vehicle dealers, and exporters, as well as to the public. Copart, Inc. was incorporated in 1982 and is headquartered in Dallas, Texas.","employees":21000,"website":"https://www.copart.com"},"financials":{"revenue":{"2023":3869518000.0,"2024":4236823000.0,"2025":4646958000.0,"2026":4666209000.0},"net_income":{"2023":1237741000.0,"2024":1363020000.0,"2025":1552449000.0,"2026":1484270000.0},"operating_income":{"2023":1486569000.0,"2024":1572023000.0,"2025":1696714000.0,"2026":1652590000.0},"free_cash_flow":{"2023":847574000.0,"2024":961574000.0,"2025":1230760000.0,"2026":1267129000.0},"total_debt":{"2023":120453000.0,"2024":118733000.0,"2025":103739000.0,"2026":88367000.0},"equity":{"2023":5987440000.0,"2024":7524011000.0,"2025":9187033000.0,"2026":9097295000.0},"cash":{"2023":2363984000.0,"2024":3422158000.0,"2025":4789070000.0,"2026":4489802000.0},"current_assets":{"2023":3262604000.0,"2024":4418184000.0,"2025":5754628000.0,"2026":5568194000.0},"current_liabilities":{"2023":492769000.0,"2024":628567000.0,"2025":683281000.0,"2026":703741000.0}},"ttm":{"free_cash_flow":1267129000.0,"through":"2026-07-31"},"prices_short":{"1d":[["2026-10-28 09:30",28.61],["2026-10-28 09:35",28.58],["2026-10-28 09:40",28.74],["2026-10-28 09:45",28.83],["2026-10-28 09:50",28.88],["2026-10-28 09:55",28.93],["2026-10-28 10:00",28.9],["2026-10-28 10:05",28.89],["2026-10-28 10:10",28.86],["2026-10-28 10:15",28.91],["2026-10-28 10:20",28.86],["2026-10-28 10:25",28.86],["2026-10-28 10:30",28.92],["2026-10-28 10:35",28.9],["2026-10-28 10:40",28.86],["2026-10-28 10:45",28.84],["2026-10-28 10:50",28.84],["2026-10-28 10:55",28.86],["