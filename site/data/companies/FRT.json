{"ticker":"FRT","name":"Federal Realty Investment Trust","sector":"Real Estate","industry":"REIT - Retail","country":"United States","price":{"last":108.24,"market_cap":9408047104,"pe_ratio":21.866667,"high_52w":128.21,"low_52w":90.03,"shares_outstanding":86389197,"beta":0.935,"as_of":"2026-10-28"},"stats":{"forward_pe":33.187183,"ps_ratio":7.0449944,"pb_ratio":2.9345262,"enterprise_value":14554407936,"ev_ebitda":17.374,"peg":null,"roe":0.12550999,"roa":0.03259,"gross_margin":0.68136,"eps":4.95,"forward_eps":3.2615,"avg_50":111.4228,"avg_200":112.92495,"target_mean":127.36842,"analyst_count":19,"rating":"buy","target_low":115.0,"target_high":145.0,"prev_close":109.67,"day_low":108.03,"day_high":109.29,"volume":763041},"profile":{"description":"Federal Realty Investment Trust is a recognized leader in the ownership, operation and redevelopment of high-quality retail-based properties located primarily in major coastal markets and select underserved regions with strong economic and demographic fundamentals. Federal Realty's mission is to deliver long-term, sustainable growth through investing in communities where retail demand exceeds supply. This includes a portfolio of open-air shopping centers and mixed-use destinations\u0097such as Santana Row, Pike & Rose, and Assembly Row, which together reflect the company's ability to create distinctive, high-performing environments that serve as vibrant destinations for their communities. Federal Realty's 103 properties include approximately 3,700 tenants in 28.8 million commercial square feet, and approximately 2,700 residential units. Federal Realty has increased its quarterly dividends to its shareholders for 59 consecutive years, the longest record in the REIT industry. Federal Realty Investment Trust is based in North Bethesda, Maryland. Federal Realty Investment Trust was incorporated in 1962 in Maryland.","employees":314,"website":"https://www.federalrealty.com"},"financials":{"revenue":{"2022":1074378000.0,"2023":11321