{"ticker":"SW","name":"Smurfit Westrock Plc","sector":"Consumer Cyclical","industry":"Packaging & Containers","country":"Ireland","price":{"last":40.33,"market_cap":21154009088,"pe_ratio":42.452633,"high_52w":52.65,"low_52w":32.729,"shares_outstanding":524522908,"beta":0.914,"as_of":"2026-10-28"},"stats":{"forward_pe":11.367608,"ps_ratio":0.675286,"pb_ratio":1.1712942,"enterprise_value":35794165760,"ev_ebitda":7.822,"peg":null,"roe":0.02715,"roa":0.02621,"gross_margin":0.18160999,"eps":0.95,"forward_eps":3.5478,"avg_50":44.353,"avg_200":43.46115,"target_mean":56.36667,"analyst_count":15,"rating":"strong_buy","target_low":46.0,"target_high":69.0,"prev_close":42.54,"day_low":39.09,"day_high":41.35,"volume":11729186},"profile":{"description":"Smurfit Westrock Plc, together with its subsidiaries, manufactures, distributes, and sells containerboard, corrugated containers, and other paper-based packaging products in North America, South America, Europe, Asia, Africa, Australia, and internationally. The company produces containerboard and paperboard; packaging of corrugated containers; consumer packaging; and offers solid board, kraft paper, and graphic board, as well as other packaging products, such as solidboard packaging, paper sacks and bag-in-box. It produces linerboard and corrugated medium and paperboard; and other paper-based packaging, such as folding cartons, inserts, labels and displays. The company primarily serves food and beverage, healthcare, beauty and personal care, garden, consumer goods, industrial, and foodservice markets. It markets its products through its own sales force, independent sales representatives, and independent distributors. Smurfit Westrock Plc was founded in 1934 and is headquartered in Dublin, Ireland.","employees":96000,"website":"https://www.smurfitwestrock.com"},"financials":{"revenue":{"2022":13509000000.0,"2023":12093000000.0,"2024":21109000000.0,"2025":31179000000.0},"net_income":{"2022":1034000000.0,"2023":825000000.0,"2024":319