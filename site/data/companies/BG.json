{"ticker":"BG","name":"Bunge Global SA","sector":"Consumer Defensive","industry":"Farm Products","country":"United States","price":{"last":100.8,"market_cap":19365607424,"pe_ratio":20.079681,"high_52w":134.87,"low_52w":88.24,"shares_outstanding":192119123,"beta":0.719,"as_of":"2026-10-28"},"stats":{"forward_pe":9.022872,"ps_ratio":0.21091068,"pb_ratio":1.2138436,"enterprise_value":37095608320,"ev_ebitda":11.867,"peg":null,"roe":0.071779996,"roa":0.03472,"gross_margin":0.049239997,"eps":5.02,"forward_eps":11.17161,"avg_50":111.6434,"avg_200":117.2502,"target_mean":140.55556,"analyst_count":9,"rating":"buy","target_low":116.0,"target_high":155.0,"prev_close":101.36,"day_low":99.985,"day_high":102.0499,"volume":1463873},"profile":{"description":"Bunge Global SA operates as an agribusiness and food company worldwide. It operates through four segments: Soybean Processing and Refining, Softseed Processing and Refining, Other Oilseeds Processing and Refining, and Grain Merchandising and Milling. The Soybean Processing and Refining segment is involved in the purchase, storage, transportation, processing, distribution, refining, marketing, and sale of soybeans and soybean related products, as well as biodiesel and fertilizer production and distribution for the food, animal feed and biofuel industries. The Softseed Processing and Refining segment is involved in the purchase, storage, transportation, processing, distribution, refining, marketing, and sale of softseeds and softseed related products, as well as biodiesel production and distribution. The Other Oilseeds Processing and Refining Segment is involved in products of a specialty nature, including the purchase, storage, transportation, processing, distribution, refining, marketing, and sale of these related products. The Grain Merchandising and Milling segment is involved in the purchase, storage, transportation, distribution, and marketing of commodities primarily consisting of corn, wheat, barley, cotton, pulses, and sugar; milling of wheat and sugar; and related services including ocean freight and financial services. Bunge Global SA was founded in 1818 and is headquartered in Chesterfield, Missouri.","employees":34000,"website":"https://www.bunge.com"},"financials":{"revenue":{"2022":67232000000.0,"2023":59540000000.0,"2024":53108000000.0,"2025":70329000000.0},"net_income":{"2022":1610000000.0,"2023":2243000000.0,"2024":1137000000.0,"2025":816000000.0},"operating_income":{"2022":2313000000.0,"2023":3130000000.0,"2024":1617000000.0,"2025":1296000000.0},"free_cash_flow":{"2022":-6104000000.0,"2023":2186000000.0,"2024":524000000.0,"2025":-879000000.0},"total_debt":{"2022":5623000000.0,"2023":5756000000.0,"2024":7119000000.0,"2025":15855000000.0},"equity":{"2022":9224000000.0,"2023":10851000000.0,"2024":9913000000.0,"2025":15904000000.0},"cash":{"2022":1223000000.0,"2023":2707000000.0,"2024":3795000000.0,"2025":2204000000.0},"current_assets":{"2022":16758000000.0,"2023":16350000000.0,"2024":15958000000.0,"2025":24391000000.0},"current_liabilities":{"2022":9600000000.0,"2023":7687000000.0,"2024":7435000000.0,"2025":15127000000.0}},"ttm":{"free_cash_flow":-711000000.0,"through":"2026-06-30"},"prices_short":{"1d":[["2026-10-28 09:30",101.31],["2026-10-28 09:35",101.42],["2026-10-28 09:40",101.61],["2026-10-28 09:45",101.51],["2026-10-28 09:50",101.33],["2026-10-28 09:55",101.6],["2026-10-28 10:00",101.6],["2026-10-28 10:05",101.67],["2026-10-28 10:10",101.93],["2026-10-28 10:15",101.71],["2026-10-28 10:20",101.58],["2026-10-28 10:25",101.54],["2026-10-28 10:30",101.36],["2026-10-28 10:35",101.27],["2026-10-28 10:40",101.19],["2026-10-28 10:45",101.14],["2026-10-28 10:50",101.23],["2026-10-28 10:55",101.08],["2026-10-28 11:00",101.11],["2026-10-28 11:05",101.44],["2026-10-28 11:10",101.12],["2026-10-28 11:15",101.34],["2026-10-28 11:20",101.5],["2026-10-28 11:25",101.07],["2026-10-28 11:30",101.12],["2026-10-28 11:35",100.72],["2026-10-28 11:40",100.89],["2026-10-28 11:45",101.08],["20