{"ticker":"PODD","name":"Insulet Corporation","sector":"Healthcare","industry":"Medical Devices","country":"United States","price":{"last":148.93,"market_cap":10328920064,"pe_ratio":27.889511,"high_52w":354.88,"low_52w":126.4,"shares_outstanding":69354199,"beta":1.101,"as_of":"2026-10-28"},"stats":{"forward_pe":19.285753,"ps_ratio":3.38276,"pb_ratio":7.262398,"enterprise_value":10742420480,"ev_ebitda":17.47,"peg":1.1785,"roe":0.26016,"roa":0.09715,"gross_margin":0.71075,"eps":5.34,"forward_eps":7.72228,"avg_50":140.8192,"avg_200":180.7409,"target_mean":167.1739,"analyst_count":23,"rating":"none","target_low":143.0,"target_high":215.0,"prev_close":149.83,"day_low":146.62,"day_high":150.56,"volume":1034997},"profile":{"description":"Insulet Corporation develops, manufactures, and sells insulin delivery systems for people with insulin-dependent diabetes in the United States and internationally. The company offers Omnipod platform products comprising Omnipod 5 automated insulin delivery system, which includes a proprietary AID algorithm embedded in the pod that integrates with a third-party continuous glucose monitor to obtain glucose values through wireless Bluetooth communication; Omnipod DASH insulin management system that features a Bluetooth enabled pod that is controlled by a smartphone-like personal diabetes manager with a color touch screen user interface; and the Omnipod Insulin Management System. It also provides pods for Amgen for use in the Neulasta Onpro kit, which is a delivery system to help reduce the risk of infection after intense chemotherapy. The company sells its products to end-users through the pharmacy channel; and independent distributors. Insulet Corporation was incorporated in 2000 and is headquartered in Acton, Massachusetts.","employees":5400,"website":"https://www.insulet.com"},"financials":{"revenue":{"2022":1305300000.0,"2023":1697100000.0,"2024":2071600000.0,"2025":2708100000.0},"net_income":{"2022":4600000.0,"2023":206300000.0,"2024":41