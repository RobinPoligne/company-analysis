rators. The Coca-Cola Company was founded in 1886 and is headquartered in Atlanta, Georgia.","employees":65900,"website":"https://www.coca-colacompany.com"},"financials":{"revenue":{"2022":43004000000.0,"2023":45754000000.0,"2024":47061000000.0,"2025":47941000000.0},"net_income":{"2022":9542000000.0,"2023":10714000000.0,"2024":10631000000.0,"2025":13107000000.0},"operating_income":{"2022":12042000000.0,"2023":13098000000.0,"2024":14022000000.0,"2025":14911000000.0},"free_cash_flow":{"2022":9534000000.0,"2023":9747000000.0,"2024":4741000000.0,"2025":5296000000.0},"total_debt":{"2022":39149000000.0,"2023":42064000000.0,"2024":44522000000.0,"2025":45492000000.0},"equity":{"2022":24105000000.0,"2023":25941000000.0,"2024":24856000000.0,"2025":32169000000.0},"cash":{"2022":11631000000.0,"2023":13663000000.0,"2024":14571000000.0,"2025":15806000000.0},"current_assets":{"2022":22591000000.0,"2023":26732000000.0,"2024":25997000000.0,"2025":31044000000.0},"current_liabilities":{"2022":19724000000.0,"2023":23571000000.0,"2024":25249000000.0,"2025":21281000000.0}},"ttm":{"free_cash_flow":14297000000.0,"through":"2026-06-30"},"prices_short":{"1d":[["2026-10-28 09:30",91.18],["2026-10-28 09:35",91.21],["2026-10-28 09:40",91.31],["2026-10-28 09:45",91.31],["2026-10-28 09:50",91.48],["2026-10-28 09:55",91.56],["2026-10-28 10:00",91.55],["2026-10-28 10:05",91.54],["2026-10-28 10:10",91.67],["2026-10-28 10:15",91.64],["2026-10-28 10:20",91.59],["2026-10-28 10:25",91.64],["2026-10-28 10:30",91.83],["2026-10-28 10:35",91.92],["2026-10-28 10:40",91.97],["2026-10-28 10:45",92.16],["2026-10-28 10:50",92.04],["2026-10-28 10:55",92.06],["2026-10-28 11:00",92.17],["2026-10-28 11:05",92.13],["2026-10-28 11:10",92.18],["2026-10-28 11:15",92.22],["2026-10-28 11:20",92.25],["2026-10-28 11:25",92.18],["2026-10-28 11:30",92.18],["2026-10-28 11:35",92.12],["2026-10-28 11:40",92.17],["2026-10-28 11:45",92.17],["2026-10-28 11:50",92.12],["2026-10-28 11:55",92.03],["2026-10-28 12:00",91.99],["2026-10-2