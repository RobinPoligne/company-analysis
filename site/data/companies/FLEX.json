{"ticker":"FLEX","name":"Flex Ltd.","sector":"Technology","industry":"Electronic Components","country":"United States","price":{"last":93.03,"market_cap":34370904064,"pe_ratio":35.91892,"high_52w":166.86,"low_52w":53.07,"shares_outstanding":369460443,"beta":1.658,"as_of":"2026-10-28"},"stats":{"forward_pe":13.181759,"ps_ratio":1.1743912,"pb_ratio":6.247817,"enterprise_value":33879738368,"ev_ebitda":15.958,"peg":null,"roe":0.18378,"roa":0.044159997,"gross_margin":0.0953,"eps":2.59,"forward_eps":7.05748,"avg_50":107.1116,"avg_200":102.70915,"target_mean":155.9,"analyst_count":10,"rating":"strong_buy","target_low":135.0,"target_high":180.0,"prev_close":83.35,"day_low":83.76,"day_high":93.735,"volume":12964825},"profile":{"description":"Flex Ltd. provides technology innovation, supply chain, and manufacturing solutions to data center, communications, enterprise, consumer, automotive, healthcare, industrial, and power industries in the Americas, Asia, and Europe. The company operates through three segments: Integrated Technology Solutions (ITS), Regulated Manufacturing Solutions (RMS), and Cloud and Power Infrastructure (CPI). The ITS segment offers flexible supply and manufacturing solutions for communications, including high speed networking, enterprise, and satellite communications systems, as well as lifestyle solutions comprising products across commercial, home, and personal product categories. Its RMS segment includes industrial products, such as mission critical automation, energy, and industrial infrastructure; automotive products, including compute and power electronics platforms and integrated systems; and healthcare products comprising regulated manufacturing for medical devices, drug delivery, and equipment. The CPI segment provides cloud and cooling products, such as integrated compute systems supporting power dense digital infrastructure deployments and advanced liquid cooling solutions supporting higher density, power intensive rack architectures; and power products that include utility and facility level electrical infrastructure enabling power delivery and high density rack and board level power systems. The company was formerly known as Flextronics International Ltd. and changed its name to Flex Ltd. in September 2016. Flex Ltd. was founded in 1969 and is headquartered in Austin, Texas.","employees":149686,"website":"https://www.flex.com"},"financials":{"revenue":{"2023":28502000000.0,"2024":26415000000.0,"2025":25813000000.0,"2026":27914000000.0},"net_income":{"2023":793000000.0,"2024":1006000000.0,"2025":838000000.0,"2026":880000000.0},"operating_income":{"2023":1021000000.0,"2024":873000000.0,"2025":1185000000.0,"2026":1447000000.0},"free_cash_flow":{"2023":315000000.0,"2024":796000000.0,"2025":1067000000.0,"2026":1052000000.0},"total_debt":{"2023":4198000000.0,"2024":3751000000.0,"2025":4148000000.0,"2026":4316000000.0},"equity":{"2023":5351000000.0,"2024":5325000000.0,"2025":5002000000.0,"2026":5144000000.0},"cash":{"2023":3164000000.0,"2024":2474000000.0,"2025":2289000000.0,"2026":2389000000.0},"current_assets":{"2023":16033000000.0,"2024":12992000000.0,"2025":12841000000.0,"2026":16332000000.0},"current_liabilities":{"2023":10867000000.0,"2024":8539000000.0,"2025":9850000000.0,"2026":12016000000.0}},"ttm":{"free_cash_flow":1052000000.0,"through":"2026-03-31"},"prices_short":{"1d":[["2026-10-28 09:30",84.69],["2026-10-28 09:35",86.04],["2026-10-28 09:40",87.47],["2026-10-28 09:45",87.4],["2026-10-28 09:50",87.19],["2026-10-28 09:55",87.04],["2026-10-28 10:00",86.72],["2026-10-28 10:05",86.31],["2026-10-28 10:10",86.6],["2026-10-28 10:15",86.24],["2026-10-28 10:20",86.56],["2026-10-28 10:25",86.68],["2026-10-28 10:30",86.45],["2026-10-28 10:35",86.19],["2026-10-28 10:40",86.42],["2026-10-28 10:45",87.07],["2026-10-28 10:50",86.83],["2026-10-28 10:55",87.14],["2026-10-28 11:00",87.18],["2026-10-28 11:05",88.54],["2026-10-28 11:10",89.41],["2026-10-28 11:15",89.49],["2026-10-28 11:20",90.59],["2026-10-28 11:25